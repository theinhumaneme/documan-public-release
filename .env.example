# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never gain a real value — it exists to name what is required, nothing else.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Anything without a value below has no default in docker-compose.yml either:
# leaving it blank stops the stack at startup naming the variable, rather than
# starting something that half works.

# --- images -----------------------------------------------------------------
# Image coordinates. docker-compose.yml defaults these; docker-compose.remote.yml
# requires API_TAG and WEB_TAG explicitly, because a deployment silently pulling
# whatever ":v1" happens to point at is how you roll back by accident.
IMAGE_REPO=theinhumaneme/images
API_TAG=documan-java-25-v1
WEB_TAG=documan-angular-21-v1

# docker-compose.remote.yml only. Loopback ports for the host's TLS terminator,
# and container memory limits for a small server.
API_PORT=8082
API_MEM=448m
WEB_MEM=64m

# Port the site is served on. Only `web` is published; the API, database, cache
# and search engine are reachable only from inside the compose network.
WEB_PORT=8080

# --- database ---------------------------------------------------------------
DB_NAME=documan
DB_USERNAME=
DB_PASSWORD=

# --- cache ------------------------------------------------------------------
REDIS_PASSWORD=

# --- search -----------------------------------------------------------------
MEILI_MASTER_KEY=
# Index uids are global to a Meilisearch instance, so two deployments sharing one
# server overwrite each other's documents unless this differs.
MEILI_INDEX_PREFIX=documan_prod_

# --- identity (Clerk) -------------------------------------------------------
# All three are public identifiers. Clerk's *secret* key is not used by either
# service and must not be added here: the API verifies tokens against the
# published signing keys and never calls Clerk.
#
# Take the first two from <frontend-api>/.well-known/openid-configuration rather
# than assembling them; an issuer differing by a trailing slash fails every
# request as an invalid token.
CLERK_ISSUER_URI=https://fleet-lizard-10.clerk.accounts.dev
CLERK_JWK_SET_URI=https://fleet-lizard-10.clerk.accounts.dev/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=pk_test_ZmxlZXQtbGl6YXJkLTEwLmNsZXJrLmFjY291bnRzLmRldiQ
# Must match the template configured in the Clerk dashboard, which has to emit
# email, given_name and family_name — the API cannot provision a row without them.
CLERK_JWT_TEMPLATE=documan
# Optional. Blank skips the audience check, which is defensible while one Clerk
# instance serves one application. Set it here and in the template together, or
# in neither; a value on one side alone rejects every request.
CLERK_AUDIENCE=

# --- object storage (Cloudflare R2) -----------------------------------------
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FILES_BUCKET=
R2_FILES_PUBLIC_URL=

# --- behaviour --------------------------------------------------------------
# `update` adds columns and never removes them, and will not say what it is about
# to do. Move to `validate` once a migration tool owns the schema.
DDL_AUTO=update
LOG_LEVEL=info
